{
  "name": "koptic-desktop",
  "productName": "Koptic",
  "version": "0.2.2",
  "private": true,
  "description": "Koptic for your computer: your school work, read straight from Classroom.",
  "author": "Koptic",
  "homepage": "https://koptic.vercel.app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.koptic.desktop",
    "productName": "Koptic",
    "copyright": "Koptic",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload-koptic.js",
      "classroom-scripts.js",
      "icon.png",
      "tray.png",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "anthonyfeng09-lang",
        "repo": "koptic-desktop",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Koptic-Setup.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Koptic",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.education",
      "artifactName": "Koptic-Mac.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Koptic"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education",
      "artifactName": "Koptic-Linux.${ext}"
    }
  }
}
